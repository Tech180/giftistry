# Pin sibling app repos for CI image builds (refs or tags).
# Used by .github/workflows/publish-images.yml
#
# Current app versions (informational; image tag is GIFTISTRY_VERSION in .env):
#   giftistry-bun    0.0.25
#   giftistry-react  0.1.2
#   theming-engine   0.0.4

GIFTISTRY_BUN_REPO=Tech180/giftistry-bun
GIFTISTRY_BUN_REF=main

GIFTISTRY_REACT_REPO=Tech180/giftistry-react
GIFTISTRY_REACT_REF=main

THEMING_ENGINE_REPO=Tech180/theming-engine
THEMING_ENGINE_REF=main
