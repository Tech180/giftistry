# Copy to .env and fill in values before `docker compose up`.

# --- Images ---
GHCR_OWNER=tech180
GIFTISTRY_VERSION=v0.0.22

# Bundled Postgres (profile `db`). Comment out the next line to use an external/local DB.
COMPOSE_PROFILES=db

# --- Web ---
WEB_PORT=8080

# --- PostgreSQL ---
# When COMPOSE_PROFILES=db is set, leave PGHOST=postgres (compose service name).
# When using an external DB, comment out COMPOSE_PROFILES=db and set e.g.:
#   PGHOST=host.docker.internal
PGHOST=postgres
PGPORT=5432
PGUSER=giftistry
PGPASSWORD=change-me-use-a-long-random-password
PGDATABASE=giftistry

# --- API secrets ---
# JWT is optional: if unset, Bun auto-generates and persists to
# /var/lib/giftistry/jwt_secret on the giftistry_data volume (back up that volume).
# To set explicitly (≥ 32 chars), uncomment:
# JWT_SECRET=
# JWT_SECRET_FILE=/run/secrets/jwt_secret
# CREDENTIALS_DIRECTORY=/run/secrets
# To forbid auto-generation: GIFTISTRY_AUTO_JWT_SECRET=false

# --- Public URL (emails, passkeys, OAuth redirects) ---
GIFTISTRY_PUBLIC_APP_URL=http://localhost:8080

# --- First-run setup ---
GIFTISTRY_ALLOW_SETUP=true
# GIFTISTRY_SETUP_TOKEN=

# --- SMTP (defaults target Mailpit when profile `mail` is enabled) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@giftistry.local

# --- Optional Mailpit host ports (profile: mail) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
